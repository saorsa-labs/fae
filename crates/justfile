# Fae headless-core workspace (Phase 1). Run from crates/.
#
# Clear the inherited `RUSTFLAGS="-D warnings"` (set in the dev shell profile)
# for every recipe. With the vendored mistral.rs + candle path-patches
# (../vendor, branch daemon-metal-fix), env-level `-D warnings` would escalate
# upstream's own warnings into hard errors during dependency compilation —
# cargo only auto-caps lints for *git/registry* deps, not path deps, and env
# RUSTFLAGS bypasses that cap. The zero-warning gate for OUR crates is the
# explicit `cargo clippy -- -D warnings` step below: clippy caps lints on path
# deps (they warn, never fail) while still hard-failing on workspace members.
export RUSTFLAGS := ""

default: check

# Full validation — zero warnings, all tests.
#
# The clippy invocations MIRROR .github/workflows/ci-linux.yml so a green local
# `just check` means a green CI: the workspace-wide `-D warnings` pass is the
# broad safety net, and the per-crate passes add the strict production-safety
# lints (`-D clippy::panic -D clippy::unwrap_used -D clippy::expect_used`) that
# CI enforces on the daemon binary, fae-engine, and fae-metaopt.
check:
    cargo fmt --all -- --check
    cargo clippy --all-targets --all-features -- -D warnings
    cargo clippy -p fae-daemon --bin fae-daemon -p fae-engine --all-targets --all-features \
        -- -D warnings -D clippy::panic -D clippy::unwrap_used -D clippy::expect_used
    cargo clippy -p fae-metaopt --all-targets --all-features \
        -- -D warnings -D clippy::panic -D clippy::unwrap_used -D clippy::expect_used
    cargo test --all-features

fmt:
    cargo fmt --all

test:
    cargo test --all-features

build-release:
    cargo build --release

# Run the daemon skeleton (no ports opened; bootstraps run dir + token + demo authz).
run:
    cargo run -p fae-daemon
