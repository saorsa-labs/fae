            tensor<fp16, [1, 128]> input_cast_fp16 = reduce_mean(axes = input_axes_0, keep_dims = input_keep_dims_0, x = x_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [5, 128]> classifier_weight_to_fp16 = const()[name = tensor<string, []>("classifier_weight_to_fp16"), val = tensor<fp16, [5, 128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(197696)))];
            tensor<fp16, [5]> classifier_bias_to_fp16 = const()[name = tensor<string, []>("classifier_bias_to_fp16"), val = tensor<fp16, [5]>([0x1.1f4p-4, -0x1.3dp-3, 0x1.cb8p-5, 0x1.93p-3, -0x1.09cp-5])];
            tensor<fp16, [1, 5]> logits = linear(bias = classifier_bias_to_fp16, weight = classifier_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_0_cast_fp16")];
        } -> (logits);
