            tensor<fp16, [1, 128, 48]> input_1_cast_fp16 = transpose(perm = input_1_perm_0, x = mel_input)[name = tensor<string, []>("transpose_0")];
            tensor<fp16, [1, 64, 48]> var_19_cast_fp16 = conv(bias = conv1_bias_to_fp16, dilations = var_19_dilations_0, groups = var_19_groups_0, pad = var_19_pad_0, pad_type = var_19_pad_type_0, strides = var_19_strides_0, weight = conv1_weight_to_fp16, x = input_1_cast_fp16)[name = tensor<string, []>("op_19_cast_fp16")];
            tensor<fp16, [1, 64, 48]> x_3_cast_fp16 = relu(x = var_19_cast_fp16)[name = tensor<string, []>("x_3_cast_fp16")];
            tensor<int32, [3]> input_3_begin_0 = const()[name = tensor<string, []>("input_3_begin_0"), val = tensor<int32, [3]>([0, 0, 0])];
            tensor<int32, [3]> input_3_end_0 = const()[name = tensor<string, []>("input_3_end_0"), val = tensor<int32, [3]>([1, 64, 48])];
            tensor<bool, [3]> input_3_end_mask_0 = const()[name = tensor<string, []>("input_3_end_mask_0"), val = tensor<bool, [3]>([true, true, true])];
            tensor<int32, [3]> input_3_stride_0 = const()[name = tensor<string, []>("input_3_stride_0"), val = tensor<int32, [3]>([1, 1, 2])];
            tensor<fp16, [1, 64, 24]> input_3_cast_fp16 = slice_by_index(begin = input_3_begin_0, end = input_3_end_0, end_mask = input_3_end_mask_0, stride = input_3_stride_0, x = x_3_cast_fp16)[name = tensor<string, []>("input_3_cast_fp16")];
            tensor<string, []> var_46_pad_type_0 = const()[name = tensor<string, []>("op_46_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [2]> var_46_pad_0 = const()[name = tensor<string, []>("op_46_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> var_46_strides_0 = const()[name = tensor<string, []>("op_46_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [1]> var_46_dilations_0 = const()[name = tensor<string, []>("op_46_dilations_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, []> var_46_groups_0 = const()[name = tensor<string, []>("op_46_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [128, 64, 3]> conv2_weight_to_fp16 = const()[name = tensor<string, []>("conv2_weight_to_fp16"), val = tensor<fp16, [128, 64, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(49472)))];
            tensor<fp16, [128]> conv2_bias_to_fp16 = const()[name = tensor<string, []>("conv2_bias_to_fp16"), val = tensor<fp16, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(98688)))];
            tensor<fp16, [1, 128, 24]> var_46_cast_fp16 = conv(bias = conv2_bias_to_fp16, dilations = var_46_dilations_0, groups = var_46_groups_0, pad = var_46_pad_0, pad_type = var_46_pad_type_0, strides = var_46_strides_0, weight = conv2_weight_to_fp16, x = input_3_cast_fp16)[name = tensor<string, []>("op_46_cast_fp16")];
            tensor<fp16, [1, 128, 24]> x_5_cast_fp16 = relu(x = var_46_cast_fp16)[name = tensor<string, []>("x_5_cast_fp16")];
            tensor<int32, [3]> input_5_begin_0 = const()[name = tensor<string, []>("input_5_begin_0"), val = tensor<int32, [3]>([0, 0, 0])];
            tensor<int32, [3]> input_5_end_0 = const()[name = tensor<string, []>("input_5_end_0"), val = tensor<int32, [3]>([1, 128, 24])];
            tensor<bool, [3]> input_5_end_mask_0 = const()[name = tensor<string, []>("input_5_end_mask_0"), val = tensor<bool, [3]>([true, true, true])];
            tensor<int32, [3]> input_5_stride_0 = const()[name = tensor<string, []>("input_5_stride_0"), val = tensor<int32, [3]>([1, 1, 2])];
            tensor<fp16, [1, 128, 12]> input_5_cast_fp16 = slice_by_index(begin = input_5_begin_0, end = input_5_end_0, end_mask = input_5_end_mask_0, stride = input_5_stride_0, x = x_5_cast_fp16)[name = tensor<string, []>("input_5_cast_fp16")];
            tensor<string, []> var_73_pad_type_0 = const()[name = tensor<string, []>("op_73_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [2]> var_73_pad_0 = const()[name = tensor<string, []>("op_73_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> var_73_strides_0 = const()[name = tensor<string, []>("op_73_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [1]> var_73_dilations_0 = const()[name = tensor<string, []>("op_73_dilations_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, []> var_73_groups_0 = const()[name = tensor<string, []>("op_73_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [128, 128, 3]> conv3_weight_to_fp16 = const()[name = tensor<string, []>("conv3_weight_to_fp16"), val = tensor<fp16, [128, 128, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(99008)))];
            tensor<fp16, [128]> conv3_bias_to_fp16 = const()[name = tensor<string, []>("conv3_bias_to_fp16"), val = tensor<fp16, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(197376)))];
            tensor<fp16, [1, 128, 12]> var_73_cast_fp16 = conv(bias = conv3_bias_to_fp16, dilations = var_73_dilations_0, groups = var_73_groups_0, pad = var_73_pad_0, pad_type = var_73_pad_type_0, strides = var_73_strides_0, weight = conv3_weight_to_fp16, x = input_5_cast_fp16)[name = tensor<string, []>("op_73_cast_fp16")];
            tensor<fp16, [1, 128, 12]> x_cast_fp16 = relu(x = var_73_cast_fp16)[name = tensor<string, []>("x_cast_fp16")];
            tensor<int32, [1]> input_axes_0 = const()[name = tensor<string, []>("input_axes_0"), val = tensor<int32, [1]>([2])];
