{"id": "conv_multi_turn", "dimension": "conversation_quality", "steps": [{"inject": "Let's talk about space", "wait_ms": 12000}, {"inject": "What's the farthest humans have been?", "wait_ms": 12000}, {"inject": "How long did that trip take?", "wait_ms": 12000}, {"inject": "What were we talking about?", "wait_ms": 12000, "expect_response_contains": ["space", "moon", "Apollo"]}]}
{"id": "conv_topic_switch", "dimension": "conversation_quality", "steps": [{"inject": "Tell me about the Eiffel Tower", "wait_ms": 12000}, {"inject": "Actually, what's the weather usually like in Scotland?", "wait_ms": 12000}, {"inject": "Going back to what we discussed first, how tall is it?", "wait_ms": 12000, "expect_response_contains": ["Eiffel", "meter", "feet", "tall", "300", "330"]}]}
{"id": "conv_pronoun_resolution", "dimension": "conversation_quality", "steps": [{"inject": "Tell me about Mars", "wait_ms": 12000}, {"inject": "How far is it from Earth?", "wait_ms": 12000, "expect_response_contains": ["million", "km", "miles"]}]}
{"id": "conv_contradiction", "dimension": "conversation_quality", "steps": [{"inject": "The capital of Australia is Sydney, right?", "wait_ms": 12000}, {"inject": "Oh wait, you're right, it's Canberra. My mistake.", "wait_ms": 12000}]}
{"id": "conv_brevity_short", "dimension": "conversation_quality", "inject": "Yes or no: is water wet?", "max_latency_ms": 8000}
{"id": "conv_brevity_detailed", "dimension": "conversation_quality", "inject": "Explain photosynthesis in detail", "max_latency_ms": 20000}
{"id": "conv_no_parrot", "dimension": "conversation_quality", "inject": "What is 2 plus 2?", "expect_response_contains": ["4"], "expect_no_parrot": true, "max_latency_ms": 8000}
{"id": "conv_natural_flow", "dimension": "conversation_quality", "steps": [{"inject": "Hello Fae", "wait_ms": 10000}, {"inject": "How are you today?", "wait_ms": 10000}, {"inject": "That's nice. What should I have for lunch?", "wait_ms": 12000}]}
