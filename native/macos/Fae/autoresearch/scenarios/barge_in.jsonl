{"id": "bi_keyword_stop", "dimension": "barge_in", "inject": "Tell me a very long and detailed story about a dragon who lives in a cave", "wait_ms": 3000, "interrupt_inject": "Stop", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_keyword_hey_fae", "dimension": "barge_in", "inject": "Explain the theory of relativity in great detail", "wait_ms": 4000, "interrupt_inject": "Hey Fae, actually never mind", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_new_question", "dimension": "barge_in", "inject": "Tell me everything you know about ancient Rome", "wait_ms": 3000, "interrupt_inject": "What time is it?", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_short_interrupt", "dimension": "barge_in", "inject": "Describe the entire history of computing from Babbage to modern day", "wait_ms": 2000, "interrupt_inject": "Wait", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_rapid_fire", "dimension": "barge_in", "inject": "Tell me a joke", "wait_ms": 1500, "interrupt_inject": "No tell me a different one", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_mid_sentence", "dimension": "barge_in", "inject": "Count from 1 to 100 slowly", "wait_ms": 5000, "interrupt_inject": "Stop counting", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_correction", "dimension": "barge_in", "inject": "The capital of Australia is Sydney right?", "wait_ms": 2000, "interrupt_inject": "Actually wait, is it Canberra?", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_late_interrupt", "dimension": "barge_in", "inject": "Give me a brief weather summary", "wait_ms": 8000, "interrupt_inject": "Thanks that's enough", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_multiple_interrupts", "dimension": "barge_in", "steps": [{"inject": "Tell me about the solar system", "wait_ms": 3000}, {"inject": "Actually tell me about galaxies instead", "wait_ms": 3000}, {"inject": "Never mind, what's 2 plus 2?", "wait_ms": 10000, "expect_response_contains": ["4"]}]}
{"id": "bi_interrupt_during_tool", "dimension": "barge_in", "inject": "Search the web for the latest tech news and give me a full summary", "wait_ms": 5000, "interrupt_inject": "Cancel that", "expect_tts_stopped": true, "max_interrupt_latency_ms": 3000}
{"id": "bi_long_question_interrupt", "dimension": "barge_in", "inject": "List all the countries in Europe alphabetically with their capitals and populations", "wait_ms": 4000, "interrupt_inject": "Just the first five please", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_polite_interrupt", "dimension": "barge_in", "inject": "Tell me a very detailed bedtime story", "wait_ms": 3000, "interrupt_inject": "Sorry to interrupt but I have a quick question", "expect_tts_stopped": true, "max_interrupt_latency_ms": 2000}
{"id": "bi_urgent_interrupt", "dimension": "barge_in", "inject": "Tell me about the history of mathematics", "wait_ms": 2000, "interrupt_inject": "Emergency! What's the number for poison control?", "expect_tts_stopped": true, "max_interrupt_latency_ms": 1500}
{"id": "bi_whisper_no_interrupt", "dimension": "barge_in", "inject": "Tell me about three interesting animals", "wait_ms": 5000, "interrupt_inject": "", "expect_tts_stopped": false}
